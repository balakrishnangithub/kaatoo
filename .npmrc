# Always install devDependencies. Some CI environments export NODE_ENV=production,
# which makes `npm ci` silently skip dev tools (eslint, tsc, vite) and the build
# then fails in confusing ways. This pins the safe default for everyone.
include=dev

# Faster, quieter installs in CI (audit/fund output is noise there).
audit=false
fund=false

# Safety net: this project's lockfile is sometimes regenerated on machines behind
# the npm.mirrors.msh.team mirror. If a lockfile with that host is ever committed,
# npm rewrites those URLs to your configured registry at fetch time (npm docs:
# "replace-registry-host"). With the current lockfile (registry.npmjs.org URLs)
# this is a no-op — registry.npmjs.org is the magic "currently configured
# registry" value, so installs work from anywhere, mirror or not.
replace-registry-host=npm.mirrors.msh.team
